generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                @id @default(autoincrement())
  username         String             @unique
  fullName         String
  email            String             @unique
  role             String             @default("user")
  passwordHash     String
  imageUrl         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  destinations     Destination[]
  favorites        Favorite[]
  purchases        Purchase[]
  activityAuthored AdminActivityLog[] @relation("activity_actor")
  activityTarget   AdminActivityLog[] @relation("activity_target")
}

enum BackgroundDisplayMode {
  ALL
  GROUP
  SINGLE
}

enum AdminActivityAction {
  USER_CREATED
  USER_UPDATED
  USER_ROLE_UPDATED
  USER_DELETED
  PASSWORD_RESET
}

model GlobalSetting {
  id                Int                   @id
  backgroundUrl     String?
  backgroundMode    BackgroundDisplayMode @default(ALL)
  backgroundGroup   String?
  backgroundImageId Int?

  backgroundImage BackgroundImage? @relation(fields: [backgroundImageId], references: [id])
}

model BackgroundImage {
  id        Int      @id @default(autoincrement())
  url       String
  title     String?
  groupKey  String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectedIn GlobalSetting[]
}

model Destination {
  id                 Int       @id @default(autoincrement())
  name               String
  city               String
  departureLocation  String    @default("A definir") // evita erro ao migrar com dados existentes
  description        String
  price              Decimal   @db.Decimal(10, 2)
  peopleCount        Int
  totalSeats         Int       @default(0)           // idem
  startDate          DateTime
  endDate            DateTime
  rating             Float
  photos             String[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  favorites Favorite[]
  purchases Purchase[]
}

model Favorite {
  id            Int          @id @default(autoincrement())
  userId        Int
  destinationId Int
  createdAt     DateTime     @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}

model AdminActivityLog {
  id        Int                   @id @default(autoincrement())
  action    AdminActivityAction
  message   String
  metadata  Json?
  actorId   Int?
  subjectId Int?
  createdAt DateTime              @default(now())

  actor   User? @relation("activity_actor", fields: [actorId], references: [id], onDelete: SetNull)
  subject User? @relation("activity_target", fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum PurchaseStatus {
  AGUARDANDO_EMISSAO
  EMITIDA
}

enum PaymentMethod {
  CARTAO
  PIX
  BOLETO
  CARNE
}

enum PaymentStatus {
  PENDENTE
  CONCLUIDO
  FALHOU
}

model Purchase {
  id         Int            @id @default(autoincrement())
  userId     Int
  packageId  Int
  seatCount  Int            @default(1) // evita erro ao migrar
  status     PurchaseStatus @default(AGUARDANDO_EMISSAO)
  observacao String         @default("")
  ticketDetails Json?
  dataCompra DateTime       @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  package   Destination @relation(fields: [packageId], references: [id], onDelete: Cascade)
  passengers Passenger[]
  payment    Payment?

  @@index([userId])
  @@index([packageId])
  @@index([status])
}

model Passenger {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  fullName   String
  cpf        String
  birthDate  DateTime
  phone      String
  email      String

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model Payment {
  id                Int            @id @default(autoincrement())
  purchaseId        Int            @unique
  method            PaymentMethod
  status            PaymentStatus  @default(PENDENTE)
  amount            Decimal        @db.Decimal(10, 2)
  externalReference String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model PixTestPayment {
  id                Int           @id @default(autoincrement())
  status            PaymentStatus @default(PENDENTE)
  amount            Decimal       @db.Decimal(10, 2)
  externalReference String
  rawResponse       Json?
  createdAt         DateTime      @default(now())
}
